# Copy this file to .env (which is git-ignored) and set your own values.
# These settings are read by docker-compose.yml, and by ./mvnw spring-boot:run if you export them.

# PostgreSQL database for AutoBook
AUTOBOOK_DB_NAME=autobook
AUTOBOOK_DB_USER=autobook
# Choose any password for your local database. Never commit the real .env file.
AUTOBOOK_DB_PASSWORD=change-me

# Port on your computer where AutoBook is published (http://localhost:8080)
AUTOBOOK_PORT=8080

# Time zone used by the application and the database (slot times are local times)
AUTOBOOK_TIMEZONE=America/Los_Angeles

# Leave empty to use the mock notification service built into AutoBook
AUTOBOOK_NOTIFICATIONS_URL=
